{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://magicmirror.builders/schemas/issues.json",
  "title": "Module Analysis Issues",
  "type": "object",
  "additionalProperties": {
    "type": "array",
    "minItems": 1,
    "items": {
      "$ref": "#/definitions/issue"
    }
  },
  "definitions": {
    "issue": {
      "type": "object",
      "required": [
        "message",
        "severity"
      ],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "Deprecated",
            "ESLint",
            "Error",
            "Information",
            "Outdated",
            "Recommendation",
            "Typo",
            "Warning"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "info",
            "warning"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
